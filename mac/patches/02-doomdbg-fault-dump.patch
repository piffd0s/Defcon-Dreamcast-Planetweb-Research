diff --git a/core/hw/sh4/sh4_interrupts.cpp b/core/hw/sh4/sh4_interrupts.cpp
index 49a3be4..2d90304 100644
--- a/core/hw/sh4/sh4_interrupts.cpp
+++ b/core/hw/sh4/sh4_interrupts.cpp
@@ -13,6 +13,7 @@
 #include "sh4_interrupts.h"
 #include "sh4_core.h"
 #include "sh4_mmr.h"
+#include "sh4_mem.h"
 #include "oslib/oslib.h"
 #include "debug/gdb_server.h"
 #include "serialize.h"
@@ -198,10 +199,28 @@ static void Do_Interrupt(Sh4ExceptionCode intEvn)
 
 void Do_Exception(u32 epc, Sh4ExceptionCode expEvn)
 {
+	{ static int dbgn = 0; if (dbgn++ < 40)
+		NOTICE_LOG(COMMON, "DOOMDBG[%d] Do_Exception epc=%08x expEvn=%03x BL=%d r15=%08x vbr=%08x TEA=%08x pr=%08x",
+			dbgn, epc, (unsigned)expEvn, (int)Sh4cntx.sr.BL, Sh4cntx.r[15], Sh4cntx.vbr, CCN_TEA, Sh4cntx.pr); }
 	assert((expEvn >= Sh4Ex_TlbMissRead && expEvn <= Sh4Ex_SlotIllegalInstr)
 			|| expEvn == Sh4Ex_FpuDisabled || expEvn == Sh4Ex_SlotFpuDisabled || expEvn == Sh4Ex_UserBreak);
 	if (Sh4cntx.sr.BL != 0)
+	{
+		// DOOMDBG: dump DOOM's debug log (dc_syscalls.c _write -> 0x8CF00000) before aborting
+		char line[210]; int li = 0;
+		for (u32 i = 0; i < 6000; i++) {
+			u8 c = ReadMem8(0x8CF00000u + i);
+			if (c == '\n' || li >= 200) {
+				line[li] = 0;
+				if (li > 0) NOTICE_LOG(COMMON, "DOOMLOG| %s", line);
+				li = 0;
+				if (c == '\n') continue;
+			}
+			line[li++] = (c >= 32 && c < 127) ? (char)c : '.';
+		}
+		if (li > 0) { line[li] = 0; NOTICE_LOG(COMMON, "DOOMLOG| %s", line); }
 		throw FlycastException("Fatal: SH4 exception when blocked");
+	}
 	CCN_EXPEVT = expEvn;
 
 	Sh4cntx.ssr = Sh4cntx.sr.getFull();
