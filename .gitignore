# This public repository intentionally contains only the native DOOM demo.
# Everything else in the larger local research workspace stays local.
*

# Repository metadata and runtime entry points.
!.gitignore
!README.md
!dreamcast_doom_native.py
!dns_redirect.py
!eden_mitm.py
!mail_poc.py
!DREAMCAST_DOOM_NATIVE_HOWTO.md

# Exact payload artifacts consumed by dreamcast_doom_native.py.
!build/
build/*
!build/pwn_stagedoom.jar
!build/doom.bin
!build/stub_native.bin

# Source used by pwn_stagedoom.jar.
!src/
src/*
!src/org/
src/org/*
!src/org/junkyard/
src/org/junkyard/*
!src/org/junkyard/Junk.java
!src/org/junkyard/StageDoom.java

# Flycast network-stack patch required by the staging route.
!patches/
patches/*
!patches/flycast-picoppp-reap.patch

# Dedicated built emulator. Mutable fchome and flash_baseline remain ignored.
!emu/
emu/*
!emu/flycast-native/
emu/flycast-native/*
!emu/flycast-native/Flycast.app/
!emu/flycast-native/Flycast.app/**

# Exact WAD consumed by the launcher.
!wad/
wad/*
!wad/doom1_trim.wad
